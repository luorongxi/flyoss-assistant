# ================ 基础配置 ================
DEBUG=True
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=DEBUG
LOG_FILE_NAME=flyoss-assistant.log

# ================ 钉钉配置 ================
DINGTALK_ENABLED=True
DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
DINGTALK_ROBOT_CODE=your_robot_code

# ================ 模型服务配置 ================
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=your_siliconflow_api_key
CHAT_MODEL=DeepSeek-V3-671B
TEMPERATURE=0.7
MAX_TOKENS=2048
EMBEDDING_MODEL=BAAI/bge-m3
DIMENSION_SIZE=1024

# ================ 存储服务配置 ================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
MEMORY_KEY=flyoss_memory
MEMORY_MAX_LENGTH=100  # 记忆保留条数，可以是-1（表示不限制），或者大于0的偶数
MEMORY_QUERY_LENGTH=10  # 最大查询长度，必须大于0的偶数

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
KNOWLEDGE_COLLECTION=flyoss_knowledge

# URL 加载配置
URL_MAX_RETRIES=3
URL_RETRY_DELAY=2.0
URL_CHUNK_SIZE=1000
URL_CHUNK_OVERLAP=200
URL_MAX_CONCURRENT=10
URL_TIMEOUT=15.0

# ================ 搜索引擎配置 ================
SERPAPI_KEY=your_searchapi_key
SEARCH_REGION=cn

# ================ 监控配置 ================
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=flyoss-assistant
LANGCHAIN_TRACING_V2=true

# ================ 代理配置 ================
HTTP_PROXY=
HTTPS_PROXY=